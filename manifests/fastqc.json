{
  "id": "fastqc",
  "name": "FastQC",
  "version": "0.12.1",
  "category": "Quality Control",
  "description": "High-throughput sequence quality control report generator for FASTQ and BAM data.",
  "install": {
    "type": "rattler",
    "packages": ["bioconda::fastqc=0.12.1"],
    "channels": ["bioconda", "conda-forge"]
  },
  "databases": [],
  "nodes": [
    {
      "id": "fastqc_runner",
      "name": "FastQC Quality Control",
      "node_type": "executor",
      "description": "Generates quality control analysis metrics and per-base quality distributions on FASTQ reads",
      "execution": {
        "type": "binary",
        "executable_name": "fastqc",
        "args_template": [
          "-o", "{work_dir}",
          "-t", "{threads}",
          "{input_files}"
        ]
      },
      "inputs": [
        {
          "id": "input_files",
          "name": "Sequence Files",
          "socket_type": "sequence_folder",
          "direction": "input"
        }
      ],
      "outputs": [
        {
          "id": "qc_html",
          "name": "Quality Report (HTML)",
          "socket_type": "html_report",
          "direction": "output"
        },
        {
          "id": "qc_data",
          "name": "FastQC Summary Data",
          "socket_type": "tsv_file",
          "direction": "output"
        }
      ],
      "params": [
        {
          "id": "threads",
          "name": "Parallel Threads (-t)",
          "type": "number",
          "default": 2,
          "min": 1,
          "max": 32,
          "step": 1,
          "description": "Number of parallel processing threads"
        },
        {
          "id": "extract",
          "name": "Auto-Extract Archives",
          "type": "boolean",
          "default": true,
          "description": "Decompress output zip files into data directories"
        }
      ],
      "output_artifacts": [
        {
          "id": "qc_html",
          "file_pattern": "*_fastqc.html",
          "label": "FastQC Interactive HTML Report",
          "format": "html"
        },
        {
          "id": "qc_data",
          "file_pattern": "fastqc_data.txt",
          "label": "Raw Metric Summary Data",
          "format": "tsv"
        }
      ]
    },
    {
      "id": "fastqc_inspector",
      "name": "FastQC Report Inspector",
      "node_type": "viewer",
      "description": "Embedded interactive web viewer for FastQC quality control distributions",
      "inputs": [
        {
          "id": "qc_html",
          "name": "Quality Report (HTML)",
          "socket_type": "html_report",
          "direction": "input"
        }
      ],
      "outputs": []
    }
  ]
}
